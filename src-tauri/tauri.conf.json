{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "نرم‌افزار حسابداری",
  "mainBinaryName": "Hesabdari",
  "version": "5.0.0",
  "identifier": "ir.hesabdari.software",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "نرم‌افزار حسابداری  |  نسخه ۵.۰",
        "width": 1560,
        "height": 980,
        "minWidth": 1120,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Farsi", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
