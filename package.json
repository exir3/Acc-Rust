{
  "name": "hesabdari",
  "private": true,
  "version": "5.0.0",
  "description": "نرم‌افزار حسابداری",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "cargo run --manifest-path src-tauri/Cargo.toml --features web --bin hesabdari-web",
    "build": "tauri build",
    "build:web": "cargo build --manifest-path src-tauri/Cargo.toml --features web --release --bin hesabdari-web",
    "tauri": "tauri",
    "check:js": "node scripts/check-js.mjs",
    "lint:js": "eslint ui scripts tests playwright.config.mjs eslint.config.js",
    "test": "node --test tests/account-picker-core.test.mjs tests/voucher-core.test.mjs tests/ui-report-wiring.test.mjs",
    "test:e2e": "playwright test",
    "test:web:http": "node scripts/smoke-web.mjs",
    "test:smoke:windows": "node scripts/smoke-windows.mjs",
    "check:signoff": "node scripts/check-report-signoff.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "2.12.4",
    "eslint": "10.14.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-promise": "7.3.0",
    "globals": "17.14.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
